# Copy this file to .env and fill in real values. Never commit .env.

# --- Required secrets ---

# ElevenLabs API key (speech-to-text). Get it from:
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Anthropic API key (answer generation). Get it from:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optional runtime config (sensible defaults if unset) ---

# Server bind address/port (Runtime Environment section of the plan)
# Production binds loopback only -- Caddy terminates TLS on 443 and proxies
# here. Binding 0.0.0.0 would serve the app unencrypted on 8000, which breaks
# the microphone (getUserMedia is secure-context-only). Use 0.0.0.0 only for
# local development without Caddy.
HOST=127.0.0.1
PORT=8000

# Public hostname for the live link (DuckDNS A record -> Elastic IP)
PUBLIC_HOSTNAME=ragingoa.duckdns.org

# Anthropic model used for generation. Recommended starting point: the
# fastest/smallest current model, claude-haiku-4-5. Confirm the exact model
# ID against current Anthropic docs before deploying -- do not assume this
# value stays correct without checking.
CLAUDE_MODEL_ID=claude-haiku-4-5

# Local embedding model (sentence-transformers) used for retrieval and the
# groundedness check. MUST match the model the FAISS indices were built with --
# build_index records it in data/<index>.manifest.json and the app refuses to
# start on a mismatch, because both models emit 384-dim vectors and retrieval
# would otherwise search an unrelated vector space and return plausible nonsense.
# Changing this means rebuilding both indices.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Guardrail thresholds. Blank uses the measured defaults in app/guardrails.py
# (off-topic 0.70, groundedness 0.40). Those were set from the real pipeline:
# in-corpus questions score 0.773-0.842, off-topic 0.499-0.649, and real
# generated answers score 0.756-0.902 against their context.
# Override here to retune without a code change; restart to apply.
OFFTOPIC_SIMILARITY_THRESHOLD=
GROUNDEDNESS_SIMILARITY_THRESHOLD=

# Note: batch size and warm-up count for the latency benchmark are constants
# in scripts/benchmark_latency.py (DEFAULT_BATCH_SIZE / DEFAULT_WARMUP_QUERIES)
# and are passed as arguments, not read from the environment.
